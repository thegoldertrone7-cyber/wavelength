{
  "name": "wavelength",
  "productName": "Wavelength",
  "version": "2.2.3",
  "description": "Free, ad-free music app: import Spotify links, play via YouTube, download MP3s.",
  "author": "Wavelength",
  "private": true,
  "main": "electron/main.js",
  "desktopName": "app.wavelength.music.desktop",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.wavelength.music",
    "productName": "Wavelength",
    "executableName": "wavelength",
    "files": [
      "server.js",
      "public/**/*",
      "!public/**/*.bak",
      "!public/**/.DS_Store",
      "electron/**/*",
      "!**/*.bak",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ytpatch",
        "to": "ytpatch"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "category": "Audio",
      "icon": "build/icon.png"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
